[sub_resource type="Shader" id="Shader_xhfnw"]
code = "
shader_type canvas_item;

uniform float progress;

void fragment() {
	vec4 source = COLOR;
	float revealed = step(progress, UV.r);
	COLOR.rgb = vec3(0.0);
	COLOR.a = mix(source.a, source.b * source.a, revealed);
}

"

